PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (free M0 cluster works)
MONGODB_URI=

# Secret used to sign session cookies (use a long random string)
SESSION_SECRET=create_session_key

# Cookie SameSite policy: "lax" for same-site/localhost, "none" if client and API are on different sites (requires HTTPS)
COOKIE_SAMESITE=lax

# Google Gemini API (for AI tutor feature - Phase 6)
# Free tier available: https://ai.google.dev/
# Sign up and get your API key from: https://makersuite.google.com/app/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL= gemini-3.8-flash # Use gemini-1.5-flash (free) or gemini-1.5-pro (faster, paid)

# Optional: raises GitHub API rate limits for public repo imports
GITHUB_TOKEN=

# Limits
MAX_PROJECTS_PER_USER=25

# Repository import limits (defaults shown)
# INGEST_MAX_ARCHIVE_MB=100
# INGEST_MAX_FILE_KB=256
# INGEST_MAX_FILES=3000
# INGEST_MAX_CONTENT_MB=15
# INGEST_TIMEOUT_SEC=120
